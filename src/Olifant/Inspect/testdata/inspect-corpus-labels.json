   "src/bistro/booking/commands/create_booking.py"
  ],
  "hits": [
   "CreateBooking imports InMemoryBookingRepository and InMemoryIdGenerator and instantiates them as defaults, with hard-coded tables t1/t2/t3. A command should depend only on the port Protocols and be handed its adapter; a caller that omits arguments silently gets non-persistent in-memory storage instead of an error."
  ],
  "patch": "cases/vm01.patch",
  "set": "V-must"
 },
 "vm02": {
  "changed": [
   "src/bistro/booking/queries/get_guest_bookings.py",
   "src/bistro/booking/queries/get_guest_bookings__test.py"
  ],
  "hits": [
   "The query imports sqlite3 and runs raw SQL against a db_path instead of calling a BookingRepository port method. This bypasses the port, ties the query to SQLite, and means it cannot be tested with the in-memory adapter."
  ],
  "patch": "cases/vm02.patch",
  "set": "V-must"
 },
 "vm03": {
  "changed": [
   "src/bistro/booking/ports/booking_repository/booking_repository.py",
   "src/bistro/booking/ports/booking_repository/booking_repository__test.py",

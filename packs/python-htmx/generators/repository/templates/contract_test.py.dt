"""Every {= Entity =}Repository adapter keeps the same contract."""

from pathlib import Path

import pytest

from {= pkg =}.models.{= e =} import {= Entity =}
from {= pkg =}.ports.{= port =}.{= port =} import {= Entity =}Repository
from {= pkg =}.ports.{= port =}.in_memory_{= port =} import InMemory{= Entity =}Repository
from {= pkg =}.ports.{= port =}.sqlite_{= port =} import Sqlite{= Entity =}Repository


@pytest.fixture(params=["in_memory", "sqlite"])
def repository(request: pytest.FixtureRequest, tmp_path: Path) -> {= Entity =}Repository:
    if request.param == "sqlite":
        return Sqlite{= Entity =}Repository(str(tmp_path / "{= e =}.sqlite3"))
    return InMemory{= Entity =}Repository()


def sample({= for f in fields =}{= if loop.first =}{= f.name =}: {= f.type =}{= end =}{= end =}) -> {= Entity =}:
    return {= Entity =}(
{=- for f in fields =}
        {= f.name =}={= if loop.first =}{= f.name =}{= elif f.scalar == "str" =}"{= f.name =}"{= elif f.scalar == "int" =}2{= elif f.scalar == "float" =}2.5{= elif f.scalar == "bool" =}True{= else =}{= ? sample: expr | a sample {= f.type =}, not None (so its codec is tested) =}{= end =},
{=- end =}
    )

{= for f in fields =}{= if loop.first =}
FIRST = {= if f.scalar == "int" =}1{= else =}"1"{= end =}
SECOND = {= if f.scalar == "int" =}2{= else =}"2"{= end =}
{= end =}{= end =}

def test_gets_what_it_saved(repository: {= Entity =}Repository) -> None:
    repository.save(sample(FIRST))
    assert repository.get(FIRST) == sample(FIRST)


def test_gets_none_for_one_never_saved(repository: {= Entity =}Repository) -> None:
    assert repository.get(SECOND) is None


def test_saving_twice_keeps_one(repository: {= Entity =}Repository) -> None:
    repository.save(sample(FIRST))
    repository.save(sample(FIRST))
    assert repository.all() == [sample(FIRST)]


def test_lists_all_in_key_order(repository: {= Entity =}Repository) -> None:
    repository.save(sample(SECOND))
    repository.save(sample(FIRST))
    assert repository.all() == [sample(FIRST), sample(SECOND)]

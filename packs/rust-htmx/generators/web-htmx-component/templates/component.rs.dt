use rscx::{component, html, props};

#[props]
pub struct {= component|pascal =}Props {
    #[builder(default)]
    children: String,
    
    #[builder(setter(into))]
    name: String,
}

#[component]
pub fn {= component|pascal =}(props: {= component|pascal =}Props) -> String {
    html! {
        <div>
            <h1>Hello {props.name}</h1>
            <div>{props.children}</div>
        </div>
    }
}

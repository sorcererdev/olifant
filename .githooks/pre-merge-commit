#!/usr/bin/env bash
# Run the test suite before any merge into main completes.
# Skip with `git merge --no-verify` (use sparingly). Fast-forward merges skip
# this hook, so main merges with --no-ff (git config branch.main.mergeoptions --no-ff).
set -euo pipefail

branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
[ "$branch" = "main" ] || exit 0

export PATH="$HOME/.ghcup/bin:/opt/homebrew/opt/rustup/bin:$PATH"
# A pack case whose tools are missing must fail here, not pass as pending.
export OLIFANT_REQUIRE_TOOLS=1
echo "pre-merge-commit: running cabal test before merging into main..." >&2
if ! cabal test --test-show-details=failures >&2; then
  echo "pre-merge-commit: tests failed; merge aborted (fix, then run \`git merge --continue\`)." >&2
  exit 1
fi

# The conventions must hold (spec §5.9): owned regions match the files (e.g.
# the cabal module lists) and no rule finding is an error.
echo "pre-merge-commit: checking conventions (olifant check)..." >&2
if ! cabal run -v0 olifant -- check --human >&2; then
  echo "pre-merge-commit: conventions do not hold; run \`olifant sync\` for regions, fix or allow (with a reason) any rule errors, commit, then \`git merge --continue\`." >&2
  exit 1
fi

# The books keep up with the code (book/README.md): a branch that changes the engine, the
# library or a pack must change book/ too, or say why not with a `Book: <reason>` trailer
# on one of its commits.
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  changed=$(git diff --name-only HEAD...MERGE_HEAD)
  if grep -qE '^(src|app|library|packs)/' <<<"$changed" \
     && ! grep -q '^book/' <<<"$changed" \
     && ! git log --format=%B HEAD..MERGE_HEAD | grep -qE '^Book: .+'; then
    echo "pre-merge-commit: this branch changes code but no book chapter. Update book/user and/or book/internals in the branch, or add a 'Book: <why no chapter changes>' trailer to one of its commits." >&2
    exit 1
  fi
fi

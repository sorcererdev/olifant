#!/usr/bin/env bash
# Run the test suite before any merge into main completes.
# Skip with `git merge --no-verify` (use sparingly).
set -euo pipefail

branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
[ "$branch" = "main" ] || exit 0

export PATH="$HOME/.ghcup/bin:$PATH"
echo "pre-merge-commit: running cabal test before merging into main..." >&2
if ! cabal test --test-show-details=failures >&2; then
  echo "pre-merge-commit: tests failed; merge aborted (fix, then run \`git merge --continue\`)." >&2
  exit 1
fi

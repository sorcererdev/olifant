cabal-version:      3.4
name:               olifant
version:            0.1.0.0
synopsis:           Olifant: Durandal's generator engine (prototype)
build-type:         Simple

common shared
  default-language:   GHC2021
  default-extensions:
    OverloadedStrings
    LambdaCase
    DerivingStrategies
  ghc-options:        -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
  build-depends:
    , base                  >=4.18 && <5
    , aeson                 >=2.1
    , bytestring            >=0.11
    , containers            >=0.6
    , directory             >=1.3
    , filepath              >=1.4
    , megaparsec            >=9.5
    , optparse-applicative  >=0.18
    , text                  >=2.0
    , time                  >=1.12
    , toml-parser           >=2.0  && <3
    , transformers          >=0.6
    , scientific            >=0.3
    , process               >=1.6
    , regex-tdfa            >=1.3
    , temporary             >=1.3

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Olifant.Generation.Render
    Olifant.Generation.Compose
    Olifant.GeneratorTesting
    Olifant.Cli.Output
    Olifant.Cli.Options
    Olifant.Cli
    Olifant.Catalog
    Olifant.Generation.Planner
    Olifant.Generation.Tools
    Olifant.Generation.Plan
    Olifant.Generation
    Olifant.Generator.Inputs
    Olifant.Generator.Load
    Olifant.Generator.Definition
    Olifant.Generator
    Olifant.Toml
    Olifant.Workspace
    Olifant.Template.Exemplar
    Olifant.Template.Render
    Olifant.Template.Parse
    Olifant.Template.Error
    Olifant.Template.Value
    Olifant.Template.Syntax
    Olifant.Template
    Olifant.Naming
    Olifant.Anchor
    Olifant.Anchor.Phrase
    Olifant.Anchor.Resolve
    Olifant.Language
    Olifant.Language.Rule
    Olifant.Language.Adapter
    Olifant.Language.Syntax
    Olifant.Language.Diagnostics
    Olifant.Language.Check
    -- olifant:library-modules

test-suite spec
  import:             shared
  type:               exitcode-stdio-1.0
  hs-source-dirs:     src
  main-is:            TestDriver.hs
  build-tool-depends: hspec-discover:hspec-discover
  build-depends:
    , hedgehog        >=1.4
    , hspec           >=2.11
    , hspec-hedgehog  >=0.1
  other-modules:
    Olifant.Generation.Render
    Olifant.Generation.Compose
    Olifant.GeneratorTesting
    Olifant.GeneratorTestingSpec
    Olifant.Cli.Output
    Olifant.Cli.Options
    Olifant.Cli
    Olifant.CliSpec
    Olifant.Catalog
    Olifant.CatalogSpec
    Olifant.Generation.Planner
    Olifant.Generation.Tools
    Olifant.Generation.Plan
    Olifant.Generation
    Olifant.GenerationSpec
    Olifant.Generator.Inputs
    Olifant.Generator.Load
    Olifant.Generator.Definition
    Olifant.Generator
    Olifant.Toml
    Olifant.GeneratorSpec
    Olifant.Workspace
    Olifant.WorkspaceSpec
    Olifant.Template.Exemplar
    Olifant.Template.Render
    Olifant.Template.Parse
    Olifant.Template.Error
    Olifant.Template.Value
    Olifant.Template.Syntax
    Olifant.Template
    Olifant.Naming
    Olifant.NamingSpec
    Olifant.TemplateSpec
    Olifant.Anchor
    Olifant.Anchor.Phrase
    Olifant.Anchor.Resolve
    Olifant.AnchorSpec
    Olifant.Language
    Olifant.Language.Rule
    Olifant.Language.Adapter
    Olifant.Language.Syntax
    Olifant.Language.Diagnostics
    Olifant.Language.Check
    Olifant.LanguageSpec
    -- olifant:test-modules

executable olifant
  import:          shared
  hs-source-dirs:  app
  main-is:         Main.hs
  build-depends:   olifant

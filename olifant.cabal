cabal-version:      3.4
name:               olifant
version:            0.1.0.0
synopsis:           Olifant: Durandal's generator engine (prototype)
build-type:         Simple

common shared
  default-language:   GHC2021
  default-extensions:
    OverloadedStrings
    LambdaCase
    DerivingStrategies
  ghc-options:        -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
  build-depends:
    , base                  >=4.18 && <5
    , aeson                 >=2.1
    , bytestring            >=0.11
    , containers            >=0.6
    , directory             >=1.3
    , filepath              >=1.4
    , megaparsec            >=9.5
    , optparse-applicative  >=0.18
    , text                  >=2.0
    , time                  >=1.12
    , toml-parser           >=2.0  && <3
    , transformers          >=0.6
    , scientific            >=0.3
    , process               >=1.6
    , regex-tdfa            >=1.3
    , temporary             >=1.3

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    -- olifant:region library-modules (generated from glob src/**/*.hs; edit the declaration, not this block)
    Olifant.Anchor
    Olifant.Anchor.Items
    Olifant.Anchor.Phrase
    Olifant.Anchor.Resolve
    Olifant.Catalog
    Olifant.Cli
    Olifant.Cli.Options
    Olifant.Cli.Output
    Olifant.Fill
    Olifant.Generation
    Olifant.Generation.Complete
    Olifant.Generation.Compose
    Olifant.Generation.FillPhase
    Olifant.Generation.Plan
    Olifant.Generation.Planner
    Olifant.Generation.Regions
    Olifant.Generation.Render
    Olifant.Generation.Tools
    Olifant.Generator
    Olifant.Generator.Choices
    Olifant.Generator.Definition
    Olifant.Generator.Inputs
    Olifant.Generator.Load
    Olifant.Generator.Schema
    Olifant.GeneratorTesting
    Olifant.Glob
    Olifant.Holes
    Olifant.Language
    Olifant.Language.Adapter
    Olifant.Language.AstGrep
    Olifant.Language.Check
    Olifant.Language.Diagnostics
    Olifant.Language.Elm
    Olifant.Language.Ghc
    Olifant.Language.Rule
    Olifant.Language.Rustc
    Olifant.Language.Support
    Olifant.Language.Syntax
    Olifant.Naming
    Olifant.Process
    Olifant.Query
    Olifant.Region
    Olifant.Suggest
    Olifant.Template
    Olifant.Template.Error
    Olifant.Template.Exemplar
    Olifant.Template.Parse
    Olifant.Template.Render
    Olifant.Template.Syntax
    Olifant.Template.Value
    Olifant.Toml
    Olifant.Workspace
    -- olifant:end library-modules

test-suite spec
  import:             shared
  type:               exitcode-stdio-1.0
  hs-source-dirs:     src
  main-is:            TestDriver.hs
  build-tool-depends: hspec-discover:hspec-discover
  build-depends:
    , hedgehog        >=1.4
    , hspec           >=2.11
    , hspec-hedgehog  >=0.1
  other-modules:
    -- olifant:region test-modules (generated from glob src/**/*.hs; edit the declaration, not this block)
    Olifant.Anchor
    Olifant.Anchor.Items
    Olifant.Anchor.Phrase
    Olifant.Anchor.Resolve
    Olifant.AnchorSpec
    Olifant.Catalog
    Olifant.CatalogSpec
    Olifant.Cli
    Olifant.Cli.Options
    Olifant.Cli.Output
    Olifant.CliSpec
    Olifant.Fill
    Olifant.Generation
    Olifant.Generation.Complete
    Olifant.Generation.Compose
    Olifant.Generation.FillPhase
    Olifant.Generation.Plan
    Olifant.Generation.Planner
    Olifant.Generation.Regions
    Olifant.Generation.Render
    Olifant.Generation.Tools
    Olifant.GenerationSpec
    Olifant.Generator
    Olifant.Generator.Choices
    Olifant.Generator.Definition
    Olifant.Generator.Inputs
    Olifant.Generator.Load
    Olifant.Generator.Schema
    Olifant.GeneratorSpec
    Olifant.GeneratorTesting
    Olifant.GeneratorTestingSpec
    Olifant.Glob
    Olifant.GlobSpec
    Olifant.Holes
    Olifant.Language
    Olifant.Language.Adapter
    Olifant.Language.AstGrep
    Olifant.Language.Check
    Olifant.Language.Diagnostics
    Olifant.Language.Elm
    Olifant.Language.Ghc
    Olifant.Language.Rule
    Olifant.Language.Rustc
    Olifant.Language.Support
    Olifant.Language.Syntax
    Olifant.LanguageSpec
    Olifant.Naming
    Olifant.NamingSpec
    Olifant.Process
    Olifant.Query
    Olifant.QuerySpec
    Olifant.Region
    Olifant.RegionSpec
    Olifant.Suggest
    Olifant.Template
    Olifant.Template.Error
    Olifant.Template.Exemplar
    Olifant.Template.Parse
    Olifant.Template.Render
    Olifant.Template.Syntax
    Olifant.Template.Value
    Olifant.TemplateSpec
    Olifant.Toml
    Olifant.Workspace
    Olifant.WorkspaceSpec
    -- olifant:end test-modules

executable olifant
  import:          shared
  hs-source-dirs:  app
  main-is:         Main.hs
  build-depends:   olifant

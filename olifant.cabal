cabal-version:      3.4
name:               olifant
version:            0.1.0.0
synopsis:           Olifant: Durandal's generator engine (prototype)
build-type:         Simple

common shared
  default-language:   GHC2021
  default-extensions:
    OverloadedStrings
    LambdaCase
    DerivingStrategies
  ghc-options:        -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
  build-depends:
    , base                  >=4.18 && <5
    , array                 >=0.5
    , aeson                 >=2.1
    , bytestring            >=0.11
    , containers            >=0.6
    , directory             >=1.3
    , filepath              >=1.4
    , megaparsec            >=9.5
    , optparse-applicative  >=0.18
    , text                  >=2.0
    , time                  >=1.12
    , toml-parser           >=2.0  && <3
    , transformers          >=0.6
    , scientific            >=0.3
    , process               >=1.6
    , regex-tdfa            >=1.3
    , temporary             >=1.3
    , unix                  >=2.8
    , async                 >=2.2
    , lsp                   >=2.8  && <2.9
    , lsp-types             >=2.4  && <2.5
    , lens                  >=5.2
    , co-log-core           >=0.3


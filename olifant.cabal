test-suite spec
  import:             shared
  type:               exitcode-stdio-1.0
  hs-source-dirs:     src
  main-is:            TestDriver.hs
  -- the specs run in parallel (SpecHook), on every core
  ghc-options:        -threaded -rtsopts "-with-rtsopts=-N"
  build-tool-depends: hspec-discover:hspec-discover
  build-depends:
    , hedgehog        >=1.4
    , hspec           >=2.11
    , hspec-hedgehog  >=0.1
    , lsp-test        >=0.18 && <0.19
